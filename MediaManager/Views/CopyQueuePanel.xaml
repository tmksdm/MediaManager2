<UserControl x:Class="MediaManager.Views.CopyQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource QueueBackgroundBrush}"
            BorderBrush="{DynamicResource QueueBorderBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding HasQueueItems, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <DockPanel Background="{DynamicResource QueueBackgroundBrush}" Margin="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Content="Очистить очередь"
                            Command="{Binding ClearQueueCommand}"
                            Style="{StaticResource QueueClearButtonStyle}"/>
                </StackPanel>
                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource QueueTitleBrush}"
                           VerticalAlignment="Center" Margin="16,6,0,6">
                    <Run Text="⏳ Очередь копирования"/>
                </TextBlock>
            </DockPanel>

            <Border MaxHeight="140">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <ItemsControl ItemsSource="{Binding CopyQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,3,16,3"
                                        BorderBrush="{DynamicResource QueueItemBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="✕"
                                                Command="{Binding DataContext.RemoveFromQueueCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource QueueRemoveButtonStyle}"
                                                ToolTip="Убрать из очереди"
                                                Margin="8,0,0,0"/>
                                        <Border DockPanel.Dock="Right"
                                                Background="{DynamicResource QueueBadgeBackgroundBrush}"
                                                CornerRadius="3"
                                                Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DestinationKey}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource QueueBadgeTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding File.FileName}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource QueueItemTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
