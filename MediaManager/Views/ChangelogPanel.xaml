<UserControl x:Class="MediaManager.Views.ChangelogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource SettingsBackgroundBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,0,1"
            MaxHeight="500">
        <DockPanel>

            <!-- Заголовок -->
            <DockPanel DockPanel.Dock="Top" Margin="20,16,20,8">
                <Button DockPanel.Dock="Right" Content="✕"
                        Style="{StaticResource SmallCloseButtonStyle}"
                        Click="CloseButton_Click"/>
                <TextBlock Text="История изменений" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Список изменений -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                <ItemsControl x:Name="changelogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Заголовок версии -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ChangelogVersionBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="#43A047"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding VersionDisplay}" FontSize="13"
                                                       FontWeight="Bold" FontFamily="Consolas"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ChangelogVersionFgBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="{Binding Date}" FontSize="12"
                                                   Foreground="{DynamicResource ChangelogDateBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Метка «текущая» -->
                                        <Border CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                Background="#E8F5E9" VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="текущая" FontSize="10" Foreground="#2E7D32"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Список изменений -->
                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="8,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Text="•" FontSize="12" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource ChangelogBulletBrush}"
                                                               VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding}" FontSize="12.5"
                                                               Foreground="{DynamicResource ChangelogTextBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="900"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>
