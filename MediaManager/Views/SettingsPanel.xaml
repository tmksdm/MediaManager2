<UserControl x:Class="MediaManager.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource SettingsBackgroundBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,12,16,12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: Основные папки -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="Основные папки"
                           FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Папка проектов:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="1" Grid.Column="1"
                           Text="{Binding ProjectBaseFolder, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="1" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseProjectBaseFolderCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Шаблон (.prproj):"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="2" Grid.Column="1"
                           Text="{Binding SourceTemplateFile, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="2" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseSourceTemplateFileCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Шаблон (.aep):"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="3" Grid.Column="1"
                           Text="{Binding AfterEffectsTemplateFile, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="3" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseAfterEffectsTemplateFileCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Папка поиска:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="4" Grid.Column="1"
                           Text="{Binding SearchFolder, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="4" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseSearchFolderCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Доп. папка поиска:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="5" Grid.Column="1"
                           Text="{Binding AdditionalSearchFolder, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="5" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseAdditionalSearchFolderCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

            </Grid>

            <!-- ПРАВАЯ КОЛОНКА: Направления копирования -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Панорама / Дайджест -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="Панорама / Дайджест"
                           FontWeight="Bold" FontSize="13"
                           Foreground="#8E24AA"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Site2 (архив):"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="1" Grid.Column="1"
                           Text="{Binding Site2Archive, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="1" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseSite2ArchiveCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Эфир (вещание):"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="2" Grid.Column="1"
                           Text="{Binding EfirPanorama, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="2" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseEfirPanoramaCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Кодер Site:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox   Grid.Row="3" Grid.Column="1"
                           Text="{Binding CoderSite, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,8" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="3" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseCoderSiteCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,8" Padding="8,3" FontSize="12" />

                <!-- Новости -->
                <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                           Text="Новости"
                           FontWeight="Bold" FontSize="13"
                           Foreground="#E53935"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Хранилище:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="5" Grid.Column="1"
                           Text="{Binding NewsStorage, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="5" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseNewsStorageCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Эфир 25к:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="6" Grid.Column="1"
                           Text="{Binding NewsEfir25, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="6" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseNewsEfir25Command}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="Кодер 25к:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox   Grid.Row="7" Grid.Column="1"
                           Text="{Binding Coder25, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,8" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="7" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseCoder25Command}"
                           VerticalAlignment="Center" Margin="0,0,0,8" Padding="8,3" FontSize="12" />

                <!-- Архив -->
                <TextBlock Grid.Row="8" Grid.ColumnSpan="3"
                           Text="Архив (сюжеты)"
                           FontWeight="Bold" FontSize="13"
                           Foreground="#43A047"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="9" Grid.Column="0"
                           Text="Сюжеты панорамы:"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,5" />
                <TextBox   Grid.Row="9" Grid.Column="1"
                           Text="{Binding ArchiveStories, UpdateSourceTrigger=LostFocus}"
                           Background="{DynamicResource SettingsInputBackgroundBrush}"
                           Foreground="{DynamicResource SettingsTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,5" Padding="4,3" FontSize="12" />
                <Button    Grid.Row="9" Grid.Column="2"
                           Content="Обзор..."
                           Command="{Binding BrowseArchiveStoriesCommand}"
                           VerticalAlignment="Center" Margin="0,0,0,5" Padding="8,3" FontSize="12" />

            </Grid>

        </Grid>
    </Border>
</UserControl>
