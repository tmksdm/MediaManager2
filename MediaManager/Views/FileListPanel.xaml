<UserControl x:Class="MediaManager.Views.FileListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Стиль для ListBox файлов внутри каждой папки -->
        <Style x:Key="FileListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        </Style>

        <!-- Стиль для каждой строки файла (ListBoxItem) -->
        <Style x:Key="FileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                BorderBrush="{DynamicResource FileRowBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource FileRowAlternateBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource FileRowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource FileRowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"
                  Background="{DynamicResource ScrollViewerBackgroundBrush}">
        <Grid>
            <!-- Пустое состояние -->
            <Border Background="{DynamicResource EmptyStateBackgroundBrush}"
                    CornerRadius="8" Padding="24" MinHeight="200"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Файлы для выбранной даты не найдены"
                               FontSize="16" Foreground="{DynamicResource EmptyStatePrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Попробуйте выбрать другую дату или нажмите «Обновить»"
                               FontSize="13" Foreground="{DynamicResource EmptyStateSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Список папок с файлами -->
            <ItemsControl ItemsSource="{Binding FolderGroups}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource FileCardBackgroundBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Background="{DynamicResource FolderHeaderBackgroundBrush}"
                                        CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding FolderName}" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FolderHeaderTextBrush}"/>
                                </Border>

                                <ListBox ItemsSource="{Binding Files}"
                                         AlternationCount="2"
                                         Style="{StaticResource FileListBoxStyle}"
                                         ItemContainerStyle="{StaticResource FileListBoxItemStyle}"
                                         PreviewKeyDown="FileListBox_PreviewKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <!-- Кнопки копирования — справа -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="12,0,0,0">

                                                    <!-- ПАНОРАМА -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FileType}" Value="Panorama">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="📁 Site2" Tag="Site2 (архив)" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#7B1FA2"/>
                                                                    <Setter Property="BorderBrush" Value="#7B1FA2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToSite2}" Value="True">
                                                                            <Setter Property="Background" Value="#7B1FA2"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#7B1FA2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="📡 Эфир" Tag="Эфир" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#6A1B9A"/>
                                                                    <Setter Property="BorderBrush" Value="#6A1B9A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToEfir}" Value="True">
                                                                            <Setter Property="Background" Value="#6A1B9A"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#6A1B9A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="🖥 Coder Site" Tag="Кодер Site" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#4A148C"/>
                                                                    <Setter Property="BorderBrush" Value="#4A148C"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToCoder}" Value="True">
                                                                            <Setter Property="Background" Value="#4A148C"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#4A148C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- ДАЙДЖЕСТ -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FileType}" Value="Digest">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="📁 Site2" Tag="Site2 (архив)" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#3F51B5"/>
                                                                    <Setter Property="BorderBrush" Value="#3F51B5"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToSite2}" Value="True">
                                                                            <Setter Property="Background" Value="#3F51B5"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#3F51B5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="📡 Эфир" Tag="Эфир" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#3949AB"/>
                                                                    <Setter Property="BorderBrush" Value="#3949AB"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToEfir}" Value="True">
                                                                            <Setter Property="Background" Value="#3949AB"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#3949AB"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="🖥 Coder Site" Tag="Кодер Site" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#283593"/>
                                                                    <Setter Property="BorderBrush" Value="#283593"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToCoder}" Value="True">
                                                                            <Setter Property="Background" Value="#283593"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#283593"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- НОВОСТИ -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FileType}" Value="News">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="📁 Архив 25к" Tag="Хранилище" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                    <Setter Property="BorderBrush" Value="#C62828"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToStorage}" Value="True">
                                                                            <Setter Property="Background" Value="#C62828"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="📡 Эфир 25к" Tag="Эфир 25к" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#B71C1C"/>
                                                                    <Setter Property="BorderBrush" Value="#B71C1C"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToEfir25}" Value="True">
                                                                            <Setter Property="Background" Value="#B71C1C"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#B71C1C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="🖥 Coder 25к" Tag="Кодер 25к" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#880E4F"/>
                                                                    <Setter Property="BorderBrush" Value="#880E4F"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToCoder25}" Value="True">
                                                                            <Setter Property="Background" Value="#880E4F"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#880E4F"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- АРХИВ -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FileType}" Value="Archive">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="📁 Сюжеты" Tag="Сюжеты" Click="CopyButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopiedToArchive}" Value="True">
                                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                </StackPanel>

                                                <!-- Бейдж типа + имя файла — слева -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,10,0" MinWidth="90">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#9E9E9E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TypeColor}" Value="#8E24AA">
                                                                        <Setter Property="Background" Value="#8E24AA"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeColor}" Value="#5C6BC0">
                                                                        <Setter Property="Background" Value="#5C6BC0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeColor}" Value="#C62828">
                                                                        <Setter Property="Background" Value="#C62828"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeColor}" Value="#43A047">
                                                                        <Setter Property="Background" Value="#43A047"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                               Foreground="{DynamicResource FileNameBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand"
                                                               MouseLeftButtonDown="FileRow_MouseLeftButtonDown"
                                                               MouseRightButtonDown="FileRow_MouseRightButtonDown">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
