<Window x:Class="MediaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MediaManager.Views"
        x:Name="mainWindow"
        Title="Медиа-менеджер"
        Icon="app.ico"
        MinWidth="1050" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Стиль кнопок навигации -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль цветных кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопок копирования: НЕ скопировано (пустая с рамкой) -->
        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопок копирования: скопировано (залитая) -->
        <Style x:Key="CopyButtonCopiedStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль кнопок title bar -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка закрытия -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C62828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C62828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль элементов в списке проектов (Popup) -->
        <Style x:Key="ProjectListItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кликабельных имён для экспорта -->
        <Style x:Key="ExportNameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#0D47A1" BorderThickness="1" Background="#F5F5F5">
        <DockPanel>

            <!-- === TITLE BAR === -->
            <Border DockPanel.Dock="Top" Background="#1565C0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Height="40">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="⚙ Настройки"
                                Command="{Binding ToggleSettingsCommand}"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="Auto" Padding="12,0" FontSize="13" Margin="0,0,8,0"/>
                        <Button Content="—" Click="MinimizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="☐" Click="MaximizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}" x:Name="maximizeButton"/>
                        <Button Content="✕" Click="CloseButton_Click"
                                Style="{StaticResource CloseButtonStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M21,17 L3,17 L3,5 L21,5 L21,17 Z M1,5 C1,3.9 1.9,3 3,3 L21,3 C22.1,3 23,3.9 23,5 L23,17 C23,18.1 22.1,19 21,19 L13,19 L13,21 L16,21 L16,23 L8,23 L8,21 L11,21 L11,19 L3,19 C1.9,19 1,18.1 1,17 L1,5 Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Медиа-менеджер" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- === SETTINGS === -->
            <views:SettingsPanel DockPanel.Dock="Top" x:Name="settingsPanel"
                                 Visibility="{Binding DataContext.IsSettingsVisible,
                                              ElementName=mainWindow,
                                              Converter={StaticResource BoolToVis}}"/>

            <!-- === TOOLBAR: ПРОЕКТ + ДАТА + ОБНОВИТЬ === -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <StackPanel>

                    <!-- Верхняя строка: создание проекта + навигация -->
                    <DockPanel Margin="16,10,16,10">
                        <!-- Правая часть: навигация по датам -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀" Command="{Binding NavigateBackCommand}"
                                    Style="{StaticResource NavButtonStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedDateText}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="▶" Command="{Binding NavigateForwardCommand}"
                                    Style="{StaticResource NavButtonStyle}" Margin="0,0,12,0"/>
                            <Button Content="Сегодня" Command="{Binding GoToTodayCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Background="#FF8F00"
                                    Margin="0,0,8,0"/>
                            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Background="#1565C0"/>
                        </StackPanel>

                        <!-- Левая часть: создание проекта -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Имя проекта:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Поле ввода + кнопка ▼ в одной рамке -->
                            <Border x:Name="projectInputBorder"
                                    BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4"
                                    Height="32" Margin="0,0,10,0">
                                <DockPanel>
                                    <!-- Кнопка ▼ справа (показываем, только если есть проекты) -->
                                    <Button x:Name="projectDropdownButton"
                                            DockPanel.Dock="Right"
                                            Content="▼" FontSize="10"
                                            Width="28" Cursor="Hand"
                                            Command="{Binding ToggleProjectListCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#757575" VerticalAlignment="Stretch"
                                            Visibility="{Binding HasTodayProjects, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Поле ввода имени -->
                                    <TextBox x:Name="projectNameTextBox"
                                             Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" VerticalContentAlignment="Center"
                                             Padding="8,0" BorderThickness="0"
                                             Width="330"
                                             PreviewMouseLeftButtonDown="ProjectNameTextBox_PreviewMouseLeftButtonDown"
                                             TextChanged="ProjectNameTextBox_TextChanged"/>
                                </DockPanel>
                            </Border>

                            <Button Content="Создать проект" Command="{Binding CreateProjectCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Background="#43A047"/>

                            <!-- Popup — выпадающий список проектов -->
                            <Popup x:Name="projectListPopup"
                                   PlacementTarget="{Binding ElementName=projectInputBorder}"
                                   Placement="Bottom"
                                   HorizontalOffset="0"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsProjectListOpen, Mode=TwoWay}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                                        CornerRadius="4" Padding="0,4"
                                        MinWidth="350" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TodayProjects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}"
                                                            Style="{StaticResource ProjectListItemStyle}"
                                                            Command="{Binding DataContext.SelectProjectCommand,
                                                                     ElementName=mainWindow}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </DockPanel>


                    <!-- Панель имён для экспорта (появляется после выбора проекта) -->
                    <Border Margin="16,6,16,10"
                            Background="#F5F5F5" CornerRadius="6" Padding="12,8"
                            Visibility="{Binding HasExportNames, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <!-- Заголовок с именем проекта и кнопкой закрытия -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="✕"
                                        FontSize="11" Foreground="#9E9E9E"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Width="20" Height="20"
                                        Click="CloseExportPanel_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock FontSize="12" Foreground="#757575" VerticalAlignment="Center">
                                    <Run Text="Имена для экспорта"/>
                                    <Run Text="—" Foreground="#BDBDBD"/>
                                    <Run Text="{Binding SelectedProject, Mode=OneWay}" FontWeight="SemiBold" Foreground="#424242"/>
                                    <Run Text="  (клик = копировать)" Foreground="#9E9E9E" FontSize="11"/>
                                </TextBlock>
                            </DockPanel>

                            <!-- Список имён — горизонтально -->
                            <ItemsControl ItemsSource="{Binding ExportNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ExportNameButtonStyle}"
                                                Command="{Binding DataContext.CopyExportNameCommand,
                                                         ElementName=mainWindow}"
                                                CommandParameter="{Binding Name}"
                                                Margin="0,0,16,4"
                                                ToolTip="Нажмите, чтобы скопировать в буфер обмена">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Цветной бейдж типа -->
                                                <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
        MinWidth="70">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#9E9E9E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#8E24AA">
                                                                    <Setter Property="Background" Value="#8E24AA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#5C6BC0">
                                                                    <Setter Property="Background" Value="#5C6BC0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#C62828">
                                                                    <Setter Property="Background" Value="#C62828"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#43A047">
                                                                    <Setter Property="Background" Value="#43A047"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                                                               FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <!-- Имя файла -->
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="#212121" VerticalAlignment="Center"
                                                           FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </Border>


            <!-- === STATUS BAR + PROGRESS (внизу) === -->
            <Border DockPanel.Dock="Bottom" Background="#E0E0E0" Padding="16,6"
                    BorderBrush="#BDBDBD" BorderThickness="0,1,0,0">
                <DockPanel>
                    <!-- Кнопка отмены — Click handler вместо Command (надёжнее в borderless-окне) -->
                    <Button DockPanel.Dock="Right"
                            Content="✕ Отменить всё"
                            Click="CancelCopyButton_Click"
                            FontSize="12" Cursor="Hand"
                            Padding="10,0" Height="22"
                            Margin="6,0,0,0"
                            Foreground="White" Background="#C62828" BorderThickness="0"
                            Visibility="{Binding IsCopying, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C62828"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#B71C1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ProgressBar DockPanel.Dock="Right"
                                 Width="200" Height="16"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding CopyProgress}"
                                 Margin="12,0,0,0"
                                 Foreground="#1565C0"
                                 Visibility="{Binding IsCopying, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#616161"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- === ПАНЕЛЬ ОЧЕРЕДИ КОПИРОВАНИЯ (над статус-баром) === -->
            <Border DockPanel.Dock="Bottom"
                    Background="#FFF8E1"
                    BorderBrush="#FFE082" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasQueueItems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Заголовок очереди -->
                    <DockPanel Background="#FFF8E1" Margin="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                            <!-- Кнопка «Очистить очередь» -->
                            <Button Content="Очистить очередь"
                                    Command="{Binding ClearQueueCommand}"
                                    FontSize="11" Foreground="#F57F17"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="8,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFECB3"/>
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F57F17" VerticalAlignment="Center" Margin="16,6,0,6">
                            <Run Text="⏳ Очередь копирования"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- Список задач в очереди -->
                    <Border MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <ItemsControl ItemsSource="{Binding CopyQueue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,3,16,3" BorderBrush="#FFECB3" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <!-- Крестик удаления — справа -->
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕"
                                                        Command="{Binding DataContext.RemoveFromQueueCommand,
                                                                 ElementName=mainWindow}"
                                                        CommandParameter="{Binding Id}"
                                                        FontSize="10" Foreground="#BDBDBD"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Width="20" Height="20"
                                                        ToolTip="Убрать из очереди"
                                                        Margin="8,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="10">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFECB3"/>
                                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <!-- Направление — справа от имени -->
                                                <Border DockPanel.Dock="Right"
                                                        Background="#FFE082" CornerRadius="3"
                                                        Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding DestinationKey}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#F57F17"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Имя файла -->
                                                <TextBlock Text="{Binding File.FileName}"
                                                           FontSize="11" Foreground="#5D4037"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- === ЖУРНАЛ КОПИРОВАНИЙ (над очередью, под списком файлов) === -->
            <Border DockPanel.Dock="Bottom"
                    Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Заголовок журнала (всегда видно если есть записи) -->
                    <DockPanel Background="#FAFAFA" Margin="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                            <!-- Кнопка «Очистить» -->
                            <Button Content="Очистить"
                                    Command="{Binding ClearLogCommand}"
                                    FontSize="11" Foreground="#9E9E9E"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="8,4" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Setter Property="Foreground" Value="#616161"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Кнопка свернуть/развернуть -->
                            <Button Command="{Binding ToggleLogCommand}"
                                    FontSize="11" Foreground="#9E9E9E"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="▲ Свернуть"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLogExpanded}" Value="False">
                                                <Setter Property="Content" Value="▼ Развернуть"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Setter Property="Foreground" Value="#616161"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="📋 История копирований" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#616161" VerticalAlignment="Center" Margin="16,6,0,6"/>
                    </DockPanel>

                    <!-- Список записей (скрывается при сворачивании) -->
                    <Border MaxHeight="160"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <ItemsControl ItemsSource="{Binding CopyLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,4,16,4" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <!-- Время -->
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding TimeText}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="#9E9E9E" VerticalAlignment="Center"
                                                           Width="60"/>
                                                <!-- Иконка статуса -->
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding StatusIcon}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" Width="18"/>
                                                <!-- Направление справа -->
                                                <Border DockPanel.Dock="Right"
                                                        CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E0E0E0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Destination}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#757575"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <!-- Имя файла -->
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="11" Foreground="#424242"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- === FILE LIST === -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid>
                    <!-- Пустое состояние -->
                    <Border Background="White" CornerRadius="8" Padding="24" MinHeight="200"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Файлы для выбранной даты не найдены"
                                       FontSize="16" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            <TextBlock Text="Попробуйте выбрать другую дату или нажмите «Обновить»"
                                       FontSize="13" Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Список папок с файлами -->
                    <ItemsControl ItemsSource="{Binding FolderGroups}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Заголовок папки -->
                                        <Border Background="White" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding FolderName}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="#424242"/>
                                        </Border>

                                        <!-- Файлы (AlternationCount=2 для «зебры») -->
                                        <ItemsControl ItemsSource="{Binding Files}" AlternationCount="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="8,6">
                                                        <!-- Фон «зебры» -->
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                           Path=(ItemsControl.AlternationIndex)}"
                                         Value="1">
                                                                        <Setter Property="Background" Value="#F7F5FA"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <DockPanel>
                                                            <!-- Кнопки копирования — справа -->
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">

                                                                <!-- ПАНОРАМА -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FileType}" Value="Panorama">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Content="📁 Site2" Tag="Site2 (архив)" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#7B1FA2"/>
                                                                                <Setter Property="BorderBrush" Value="#7B1FA2"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToSite2}" Value="True">
                                                                                        <Setter Property="Background" Value="#7B1FA2"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#7B1FA2"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="📡 Эфир" Tag="Эфир" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#6A1B9A"/>
                                                                                <Setter Property="BorderBrush" Value="#6A1B9A"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToEfir}" Value="True">
                                                                                        <Setter Property="Background" Value="#6A1B9A"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#6A1B9A"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="🖥 Кодер" Tag="Кодер Site" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#4A148C"/>
                                                                                <Setter Property="BorderBrush" Value="#4A148C"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToCoder}" Value="True">
                                                                                        <Setter Property="Background" Value="#4A148C"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#4A148C"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- ДАЙДЖЕСТ -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FileType}" Value="Digest">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Content="📁 Site2" Tag="Site2 (архив)" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#3F51B5"/>
                                                                                <Setter Property="BorderBrush" Value="#3F51B5"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToSite2}" Value="True">
                                                                                        <Setter Property="Background" Value="#3F51B5"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#3F51B5"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="📡 Эфир" Tag="Эфир" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#3949AB"/>
                                                                                <Setter Property="BorderBrush" Value="#3949AB"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToEfir}" Value="True">
                                                                                        <Setter Property="Background" Value="#3949AB"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#3949AB"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="🖥 Кодер" Tag="Кодер Site" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#283593"/>
                                                                                <Setter Property="BorderBrush" Value="#283593"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToCoder}" Value="True">
                                                                                        <Setter Property="Background" Value="#283593"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#283593"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- НОВОСТИ -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FileType}" Value="News">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Content="📁 Хранилище" Tag="Хранилище" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                                <Setter Property="BorderBrush" Value="#C62828"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToStorage}" Value="True">
                                                                                        <Setter Property="Background" Value="#C62828"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="📡 Эфир 25к" Tag="Эфир 25к" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#B71C1C"/>
                                                                                <Setter Property="BorderBrush" Value="#B71C1C"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToEfir25}" Value="True">
                                                                                        <Setter Property="Background" Value="#B71C1C"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#B71C1C"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="🖥 Кодер 25к" Tag="Кодер 25к" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#880E4F"/>
                                                                                <Setter Property="BorderBrush" Value="#880E4F"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToCoder25}" Value="True">
                                                                                        <Setter Property="Background" Value="#880E4F"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#880E4F"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- АРХИВ -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FileType}" Value="Archive">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Content="📁 Сюжеты" Tag="Сюжеты" Click="CopyButton_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButtonStyle}">
                                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                                <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopiedToArchive}" Value="True">
                                                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>

                                                            </StackPanel>

                                                            <!-- Бейдж типа + имя файла — слева -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,10,0" MinWidth="90">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#9E9E9E"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#8E24AA">
                                                                                    <Setter Property="Background" Value="#8E24AA"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#5C6BC0">
                                                                                    <Setter Property="Background" Value="#5C6BC0"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#C62828">
                                                                                    <Setter Property="Background" Value="#C62828"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TypeColor}" Value="#43A047">
                                                                                    <Setter Property="Background" Value="#43A047"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="White"
               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <!-- Имя файла — кликабельная ссылка -->
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
           Foreground="#1565C0" VerticalAlignment="Center"
           TextTrimming="CharacterEllipsis"
           Cursor="Hand"
           MouseLeftButtonDown="FileRow_MouseLeftButtonDown"
           MouseRightButtonDown="FileRow_MouseRightButtonDown">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>

                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
