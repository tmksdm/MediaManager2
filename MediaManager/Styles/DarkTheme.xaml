<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- ТЁМНАЯ ТЕМА — все цвета приложения           -->
    <!-- Ключи должны совпадать с LightTheme.xaml     -->
    <!-- ============================================ -->

    <!-- === Окно === -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"      Color="#1E1E1E"/>
    <SolidColorBrush x:Key="WindowBorderBrush"          Color="#333333"/>

    <!-- === Title bar === -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush"     Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush"     Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush"          Color="#3E3E3E"/>
    <SolidColorBrush x:Key="TitleBarPressBrush"          Color="#505050"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush"       Color="#C62828"/>

    <!-- === Toolbar (панель проекта + навигации) === -->
    <SolidColorBrush x:Key="ToolbarBackgroundBrush"      Color="#252525"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush"          Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ToolbarTextBrush"            Color="#E0E0E0"/>

    <!-- === Навигация по датам === -->
    <SolidColorBrush x:Key="NavButtonBackgroundBrush"    Color="#3A3A3A"/>
    <SolidColorBrush x:Key="NavButtonBorderBrush"        Color="#4A4A4A"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush"         Color="#4A4A4A"/>
    <SolidColorBrush x:Key="NavButtonPressBrush"         Color="#5A5A5A"/>
    <SolidColorBrush x:Key="DateTextBrush"               Color="#E0E0E0"/>

    <!-- === Поле ввода проекта === -->
    <SolidColorBrush x:Key="InputBorderBrush"            Color="#4A4A4A"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"        Color="#2D2D2D"/>
    <SolidColorBrush x:Key="InputForegroundBrush"        Color="#E0E0E0"/>
    <SolidColorBrush x:Key="InputDropdownBorderBrush"    Color="#4A4A4A"/>
    <SolidColorBrush x:Key="InputDropdownHoverBrush"     Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputDropdownPressBrush"     Color="#4A4A4A"/>
    <SolidColorBrush x:Key="InputDropdownForegroundBrush" Color="#9E9E9E"/>

    <!-- === Popup (список проектов) === -->
    <SolidColorBrush x:Key="PopupBackgroundBrush"        Color="#2D2D2D"/>
    <SolidColorBrush x:Key="PopupBorderBrush"            Color="#4A4A4A"/>
    <SolidColorBrush x:Key="PopupItemHoverBrush"         Color="#3A3A3A"/>
    <SolidColorBrush x:Key="PopupItemPressBrush"         Color="#4A4A4A"/>

    <!-- === Панель экспортных имён === -->
    <SolidColorBrush x:Key="ExportPanelBackgroundBrush"  Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ExportPanelLabelBrush"       Color="#9E9E9E"/>
    <SolidColorBrush x:Key="ExportPanelSeparatorBrush"   Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ExportPanelNameBrush"        Color="#BDBDBD"/>
    <SolidColorBrush x:Key="ExportPanelHintBrush"        Color="#757575"/>
    <SolidColorBrush x:Key="ExportNameHoverBrush"        Color="#2E3B2E"/>
    <SolidColorBrush x:Key="ExportNamePressBrush"        Color="#3A4D3A"/>
    <SolidColorBrush x:Key="ExportNameTextBrush"         Color="#E0E0E0"/>

    <!-- === Список файлов === -->
    <SolidColorBrush x:Key="FileCardBackgroundBrush"     Color="#2A2A2A"/>
    <SolidColorBrush x:Key="FolderHeaderBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="FolderHeaderTextBrush"       Color="#BDBDBD"/>
    <SolidColorBrush x:Key="FileNameBrush"               Color="#64B5F6"/>
    <SolidColorBrush x:Key="FileRowBorderBrush"          Color="#3A3A3A"/>
    <SolidColorBrush x:Key="FileRowAlternateBrush"       Color="#262630"/>
    <SolidColorBrush x:Key="FileRowHoverBrush"           Color="#1A3A5C"/>
    <SolidColorBrush x:Key="FileRowSelectedBrush"        Color="#1E4976"/>
    <SolidColorBrush x:Key="ScrollViewerBackgroundBrush" Color="Transparent"/>

    <!-- === Пустое состояние === -->
    <SolidColorBrush x:Key="EmptyStateBackgroundBrush"   Color="#2A2A2A"/>
    <SolidColorBrush x:Key="EmptyStatePrimaryBrush"      Color="#757575"/>
    <SolidColorBrush x:Key="EmptyStateSecondaryBrush"    Color="#555555"/>

    <!-- === Status bar === -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush"    Color="#2D2D2D"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="StatusBarTextBrush"          Color="#9E9E9E"/>
    <SolidColorBrush x:Key="StatusBarSpeedBrush"         Color="#BDBDBD"/>
    <SolidColorBrush x:Key="ProgressBarForegroundBrush"  Color="#42A5F5"/>

    <!-- === Панель очереди === -->
    <SolidColorBrush x:Key="QueueBackgroundBrush"        Color="#332B00"/>
    <SolidColorBrush x:Key="QueueBorderBrush"            Color="#4D4000"/>
    <SolidColorBrush x:Key="QueueTitleBrush"             Color="#FFD54F"/>
    <SolidColorBrush x:Key="QueueItemBorderBrush"        Color="#4D4000"/>
    <SolidColorBrush x:Key="QueueItemTextBrush"          Color="#FFCC80"/>
    <SolidColorBrush x:Key="QueueBadgeBackgroundBrush"   Color="#4D4000"/>
    <SolidColorBrush x:Key="QueueBadgeTextBrush"         Color="#FFD54F"/>
    <SolidColorBrush x:Key="QueueRemoveForegroundBrush"  Color="#757575"/>
    <SolidColorBrush x:Key="QueueRemoveHoverBgBrush"     Color="#4D4000"/>
    <SolidColorBrush x:Key="QueueRemoveHoverFgBrush"     Color="#FFB300"/>
    <SolidColorBrush x:Key="QueueClearForegroundBrush"   Color="#FFD54F"/>
    <SolidColorBrush x:Key="QueueClearHoverBgBrush"      Color="#4D4000"/>
    <SolidColorBrush x:Key="QueueClearHoverFgBrush"      Color="#FFB300"/>

    <!-- === Журнал копирований === -->
    <SolidColorBrush x:Key="LogBackgroundBrush"          Color="#252525"/>
    <SolidColorBrush x:Key="LogBorderBrush"              Color="#3A3A3A"/>
    <SolidColorBrush x:Key="LogHeaderBackgroundBrush"    Color="#2D2D2D"/>
    <SolidColorBrush x:Key="LogHeaderTextBrush"          Color="#9E9E9E"/>
    <SolidColorBrush x:Key="LogItemBorderBrush"          Color="#3A3A3A"/>
    <SolidColorBrush x:Key="LogTimeBrush"                Color="#757575"/>
    <SolidColorBrush x:Key="LogFileNameBrush"            Color="#BDBDBD"/>
    <SolidColorBrush x:Key="LogSuccessBackgroundBrush"   Color="#1B3A1B"/>
    <SolidColorBrush x:Key="LogSuccessForegroundBrush"   Color="#66BB6A"/>
    <SolidColorBrush x:Key="LogErrorBackgroundBrush"     Color="#3A1B1B"/>
    <SolidColorBrush x:Key="LogErrorForegroundBrush"     Color="#EF5350"/>
    <SolidColorBrush x:Key="LogCancelBackgroundBrush"    Color="#3A2D1B"/>
    <SolidColorBrush x:Key="LogCancelForegroundBrush"    Color="#FFB74D"/>
    <SolidColorBrush x:Key="LogDefaultBadgeBrush"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="LogDefaultBadgeTextBrush"    Color="#9E9E9E"/>

    <!-- === Панель настроек === -->
    <SolidColorBrush x:Key="SettingsBackgroundBrush"     Color="#252525"/>
    <SolidColorBrush x:Key="SettingsBorderBrush"         Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SettingsTextBrush"           Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SettingsInputBackgroundBrush" Color="#2D2D2D"/>

    <!-- === Кнопки: общие вспомогательные === -->
    <SolidColorBrush x:Key="SmallCloseForegroundBrush"   Color="#757575"/>
    <SolidColorBrush x:Key="SmallCloseHoverBrush"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="PanelTextForegroundBrush"    Color="#757575"/>
    <SolidColorBrush x:Key="PanelTextHoverBgBrush"       Color="#3A3A3A"/>
    <SolidColorBrush x:Key="PanelTextHoverFgBrush"       Color="#BDBDBD"/>

    <!-- === Диалог эфира === -->
    <SolidColorBrush x:Key="DialogBackgroundBrush"       Color="#2D2D2D"/>
    <SolidColorBrush x:Key="DialogCancelBgBrush"         Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DialogCancelFgBrush"         Color="#BDBDBD"/>
    <SolidColorBrush x:Key="DialogCancelHoverBrush"      Color="#4A4A4A"/>
    <SolidColorBrush x:Key="DialogCancelPressBrush"      Color="#5A5A5A"/>

    <!-- === Панель истории изменений (Changelog) === -->
    <SolidColorBrush x:Key="ChangelogVersionBgBrush"    Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ChangelogVersionFgBrush"    Color="#BDBDBD"/>
    <SolidColorBrush x:Key="ChangelogDateBrush"         Color="#757575"/>
    <SolidColorBrush x:Key="ChangelogBulletBrush"       Color="#555555"/>
    <SolidColorBrush x:Key="ChangelogTextBrush"         Color="#BDBDBD"/>


</ResourceDictionary>
