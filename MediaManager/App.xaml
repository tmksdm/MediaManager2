<Application x:Class="MediaManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediaManager"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Стили кнопок (не зависят от темы) -->
                <ResourceDictionary Source="Styles/ButtonStyles.xaml"/>
                <!-- [1] Тема по умолчанию — светлая. Заменяется в App.xaml.cs -->
                <ResourceDictionary Source="Styles/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
